{
  "routes": {
    "/Workspace": {
      "loginRequired": true,
      "authz": [{
        "resource": "/workspace",
        "service": "jupyterhub",
        "method": "access"
      }],
    },
    "/Workspaces": {
      "loginRequired": true,
      "authz": [{
        "resource": "/workspace",
        "service": "jupyterhub",
        "method": "access"
      }],
      "redirect403": "/WorkspaceRequestAccess"
    },
    "/WorkspaceRequestAccess": {
      "loginRequired": true
    },
    "/Profile": {
      "loginRequired": true
    },
    "*": {
      "loginRequired": false
    }
  }
}
